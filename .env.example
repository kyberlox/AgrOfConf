DOMAIN=localhost
HOST=http://localhost
user=user
pswd=password
POSTGRES_DB=pdb
DB_HOST=postgres
POSTGRES_PORT=5432

key_api = key_api
model_type = model_name
vseGPTurl = url

# --- Observability ---
# Вся наблюдаемость (трейсы OTel, JSON-логи в ES, метрики /metrics) включается
# ТОЛЬКО на домене OBSERVABILITY_DOMAIN (по умолчанию agrofconf.emk.ru).
# Принудительно: OBSERVABILITY_ENABLED=true / false (пусто = авто по домену)
OBSERVABILITY_ENABLED=
OBSERVABILITY_DOMAIN=agrofconf.emk.ru
# Трейсы: endpoint OTel Collector (OTLP HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_SERVICE_NAME=agrof-conf-api
# Логи: Elasticsearch и data stream для логов FastAPI
ES_HOST=http://elasticsearch:9200
LOG_DATA_STREAM=logs-agrof.app-default
# TTL логов (delete-фаза ILM-политики app-logs-ttl)
LOG_RETENTION=30d
LOG_LEVEL=INFO

# DEV-сессия для локального тестирования (максимальные права).
# DEV_SESSION_ENABLED=false отключает её и возвращает штатную авторизацию.
DEV_SESSION_ENABLED=true
DEV_USER_ID=4133